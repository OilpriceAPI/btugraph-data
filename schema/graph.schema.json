{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OilpriceAPI/btugraph-data/main/schema/graph.schema.json",
  "title": "BTU Graph public graph snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "edition",
    "generatedAt",
    "generatedFrom",
    "publisher",
    "license",
    "provenance",
    "dataDictionary",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "edition": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedFrom": { "type": "string", "minLength": 1 },
    "publisher": { "$ref": "#/$defs/publisher" },
    "license": { "$ref": "#/$defs/license" },
    "provenance": { "type": "object" },
    "dataDictionary": { "type": "object" },
    "disclosure": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "publisher": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "parentOrganization": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "license": {
      "type": "object",
      "required": ["url", "scope", "attribution"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "scope": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_-]+:[a-z0-9][a-z0-9-]*$" },
        "type": {
          "enum": [
            "company",
            "sector",
            "capability",
            "market",
            "region",
            "value_chain_stage",
            "workflow",
            "software_product",
            "category",
            "market_data_requirement",
            "decision"
          ]
        },
        "slug": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "lastReviewed": { "type": "string", "format": "date" },
        "datePublished": { "type": "string", "format": "date" },
        "lastMateriallyUpdated": { "type": "string", "format": "date" }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "relationship"],
      "properties": {
        "from": { "type": "string", "minLength": 3 },
        "to": { "type": "string", "minLength": 3 },
        "relationship": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "additionalProperties": false
    }
  }
}
